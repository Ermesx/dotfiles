{{- /* The packages view: what is selected (absent .profiles selects everything) */}}
{{- $v := includeTemplate "packages.tmpl" . | fromJson }}
{{- if eq .chezmoi.os "windows" }}
**/*.sh
{{- if has "claude-code" $v.tools }}
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/keybindings.json
!.claude/themes
!.claude/rules
!.claude/commands
!.claude/agents
!.claude/output-styles
!.claude/workflows
!.claude/skills
.claude/skills/synced
{{- else }}
{{- /* No claude-code: the whole Claude config and lazygit's AI commit script stay out */}}
.claude
.claude/**
AppData/Local/lazygit/ai-commit.ps1
{{- end }}
{{- else }}
readonly_AppData/
scoop/
readonly_Documents/
**/*.ps1
.claude
{{- end -}}

{{- /* PowerShell profile fragments of tools that are not selected; the profile does not dot-source them either */}}
{{- range $fragment := glob (joinPath .chezmoi.sourceDir "dot_profile/tools/*") }}
{{-   $tool := base $fragment | replace ".tmpl" "" | replace ".ps1" "" }}
{{-   if not (has $tool $v.tools) }}
.profile/tools/{{ $tool }}.ps1
{{-   end }}
{{- end }}

{{- /* The WSL admin step is deployed only where the WSL platform is needed: a selected profile declares a distro, or Rancher Desktop is selected */}}
{{- if not $v.wsl_platform }}
.config/dotfiles/admin/enable-wsl.ps1
{{- end }}

{{- if eq (env "CI") "true" }}
# CI: needs decryption, which never happens in CI (docs/testing.md).
# Targets are names without chezmoi prefixes; the source of each script is in its comment.
.ssh
.config/git/user.gitconfig
.config/git/allowed_signers
# run_onchange_before_decrypt-private-key.ps1.tmpl / .sh.tmpl: decrypt the age key with a passphrase
.chezmoiscripts/windows/decrypt-private-key.ps1
.chezmoiscripts/linux/decrypt-private-key.sh
# run_once_after_add-ssh-key.ps1: ssh-add of the decrypted private key
.chezmoiscripts/windows/add-ssh-key.ps1
# CI: the hosted runner cannot install a WSL distro (run_once_before_install-wsl.ps1.tmpl)
.chezmoiscripts/windows/install-wsl.ps1
{{- end }}

