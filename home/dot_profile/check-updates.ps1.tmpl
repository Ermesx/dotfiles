# Scoop apps and modules declared in packages.yaml; Check-Updates and Update-* (module PackageUpdates)
# touch only these. .NET tools are not listed: every installed global tool is checked and updated.
$Global:PackageUpdatesDeclared = @{
{{- $v := includeTemplate "packages.tmpl" . | fromJson }}
    Apps = @(
{{- range $v.scoop }}
        {{ splitList "/" . | last | squote }}{{ end }}
    )
    Modules = @(
{{- range $v.modules }}
        {{ . | squote }}{{ end }}
    )
}

# Background refresh: every tick only checks the shared cache's age; a stale cache is refreshed in a
# thread job, so the slow part (scoop update, Gallery, NuGet) never blocks the prompt
$sourceId = 'PackageUpdates-Timer'
if (-not (Get-EventSubscriber -SourceIdentifier $sourceId -ErrorAction SilentlyContinue)) {
    $Global:PackageUpdatesTimer = New-Object System.Timers.Timer
    $Global:PackageUpdatesTimer.Interval = [TimeSpan]::FromMinutes(30).TotalMilliseconds
    $Global:PackageUpdatesTimer.AutoReset = $true

    Register-ObjectEvent -InputObject $Global:PackageUpdatesTimer -EventName Elapsed -SourceIdentifier $sourceId -Action {
        try {
            # Only finished jobs can be removed; a queued (NotStarted) or running one means "busy"
            Get-Job -Name PackageUpdates-Refresh -ErrorAction SilentlyContinue |
                Where-Object State -in 'Completed', 'Failed', 'Stopped' |
                Remove-Job -ErrorAction SilentlyContinue
            if (Get-Job -Name PackageUpdates-Refresh -ErrorAction SilentlyContinue) { return }

            Import-Module PackageUpdates -DisableNameChecking
            if (-not (Test-PackageUpdatesCacheStale)) { return }

            $declared = $Global:PackageUpdatesDeclared
            Start-ThreadJob -Name PackageUpdates-Refresh -ScriptBlock {
                Import-Module PackageUpdates -DisableNameChecking
                Update-PackageUpdatesCache -Declared $using:declared
            } | Out-Null
        }
        catch {
        }
    } | Out-Null

    $Global:PackageUpdatesTimer.Start()
}
