# Created using winget configure export 1.11.430
# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.3
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: "dscv3"
resources:
  
  # docker
  - name: winget_Docker.DockerDesktop
    type: Microsoft.WinGet/Package
    metadata:
      description: "Install Docker.DockerDesktop"
    properties:
      id: "Docker.DockerDesktop"
      source: "winget"
  
  # git
  - name: winget_Git.Git
    type: Microsoft.WinGet/Package
    metadata:
      description: "Install Git.Git"
    properties:
      id: "Git.Git"
      source: "winget"
  - name: winget_JesseDuffield.lazygit
    type: Microsoft.WinGet/Package
