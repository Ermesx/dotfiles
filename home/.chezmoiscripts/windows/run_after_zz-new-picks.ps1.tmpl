{{- /* Items added to a pick profile since the last init; renders empty (chezmoi skips it) when none are pending */ -}}
{{- $v := includeTemplate "packages.tmpl" . | fromJson -}}
{{- if $v.pending -}}
{{-   $width := 0 -}}
{{-   range keys $v.pending }}{{ $width = max $width (len .) }}{{ end -}}
{{-   $format := printf "    %%-%ds %%s" (add1 $width) }}
# Lists what a pick profile gained since the choice was made; never installs and never fails apply.
Write-Host "► New items to choose from (not installed):" -ForegroundColor Yellow
{{- range $name, $labels := $v.pending }}
Write-Host '{{ printf $format (printf "%s:" $name) (join ", " $labels) }}'
{{- end }}
Write-Host '  Choose with: chezmoi init --prompt; chezmoi apply'
exit 0
{{ end -}}
