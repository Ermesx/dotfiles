$distro = {{ .packages.windows.profiles.sdk.wsl | squote }}

# wsl prints UTF-16 unless WSL_UTF8 is set; without it -contains never matches
$env:WSL_UTF8 = '1'

wsl --status *> $null
if ($LASTEXITCODE -ne 0) {
    Write-Host "► Skipping WSL distro: WSL is not enabled" -ForegroundColor Yellow
    Write-Host "  An administrator reviews and runs, in their own PowerShell 7:"
    Write-Host "    pwsh -NoProfile -ExecutionPolicy Bypass -File `"$HOME\.config\dotfiles\admin\enable-wsl.ps1`""
    Write-Host "  Then, after a restart, you run (no admin needed):"
    Write-Host "    wsl --install -d $distro --web-download --no-launch"
    exit 0
}

if (-not ((wsl -l -q) -contains $distro)) {
    Write-Host "► Installing WSL $distro" -ForegroundColor Cyan
    wsl --install -d $distro --web-download --no-launch
}
