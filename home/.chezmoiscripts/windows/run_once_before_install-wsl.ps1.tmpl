$distro = {{ .packages.windows.profiles.sdk.wsl | squote }}

# wsl prints UTF-16 unless WSL_UTF8 is set; without it -contains never matches
$env:WSL_UTF8 = '1'

wsl --status *> $null
if ($LASTEXITCODE -ne 0) {
    Write-Host "► Skipping WSL distro: WSL is not enabled. An administrator runs:" -ForegroundColor Yellow
    Write-Host "  & `"$HOME\scoop\apps\pwsh\current\pwsh.exe`" -NoProfile -ExecutionPolicy Bypass -File `"$HOME\.config\dotfiles\admin\enable-wsl.ps1`""
    exit 0
}

if (-not ((wsl -l -q) -contains $distro)) {
    Write-Host "► Installing WSL $distro" -ForegroundColor Cyan
    wsl --install -d $distro --web-download --no-launch
}
