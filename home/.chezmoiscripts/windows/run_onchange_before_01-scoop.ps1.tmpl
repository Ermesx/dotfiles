{{- $v := includeTemplate "packages.tmpl" . | fromJson -}}
{{- $buckets := list -}}
{{- range $v.scoop -}}
{{-   if contains "/" . -}}
{{-     $buckets = append $buckets (index (splitList "/" .) 0) -}}
{{-   end -}}
{{- end -}}
Write-Host "► Adding Scoop buckets" -ForegroundColor Cyan
{{- range $buckets | uniq }}
scoop bucket add {{ . }}
{{- end }}

Write-Host "► Installing Scoop apps" -ForegroundColor Cyan
{{- range $v.scoop }}
scoop install {{ . }}
{{- end }}
