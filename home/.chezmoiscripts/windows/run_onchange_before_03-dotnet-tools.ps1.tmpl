{{- $v := includeTemplate "packages.tmpl" . | fromJson -}}
{{- if $v.dotnet_tools }}
# dotnet-sdk writes its PATH entry and DOTNET_ROOT to the user registry, which this process,
# started by chezmoi before the install, does not see yet
$env:PATH = [Environment]::GetEnvironmentVariable('PATH', 'User') + ';' + [Environment]::GetEnvironmentVariable('PATH', 'Machine')
$env:DOTNET_ROOT = [Environment]::GetEnvironmentVariable('DOTNET_ROOT', 'User')

Write-Host "► Installing .NET tools" -ForegroundColor Cyan
{{- range $v.dotnet_tools }}
dotnet tool install -g {{ . }}
{{- end }}
{{ end }}
