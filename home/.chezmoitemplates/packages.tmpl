{{- $view := dict -}}
{{- range $platform := list "global" .chezmoi.os -}}
{{-   range $profile := (index $.packages $platform).profiles -}}
{{-     range $method, $items := $profile -}}
{{-       if ne $method "pick" -}}
{{-         $_ := set $view $method (concat (get $view $method | default list) $items) -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- toJson $view -}}
