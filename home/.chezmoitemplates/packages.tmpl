{{- /*
  The packages view: includeTemplate "packages.tmpl" . | fromJson
  Packages of the current platform (global + .chezmoi.os) filtered by the stored selection (.profiles, .picks, .offered).
  Without .profiles (no init yet) every profile and every pick is selected.
*/ -}}
{{- $hasSelection := hasKey . "profiles" -}}
{{- $selected := list -}}
{{- if $hasSelection -}}
{{-   $selected = .profiles | default (list) -}}
{{- end -}}
{{- $hasOffered := hasKey . "offered" -}}
{{- $sources := list (dig "packages" "global" "profiles" (dict) .) (dig "packages" .chezmoi.os "profiles" (dict) .) -}}

{{- /* Every profile name and every list method declared on the platform, selected or not;
  $view starts with an empty list per method so that a method nobody selects still reads as empty */ -}}
{{- $names := list -}}
{{- $view := dict -}}
{{- range $source := $sources -}}
{{-   range $name, $definition := $source -}}
{{-     $names = append $names $name -}}
{{-     range $method, $items := $definition -}}
{{-       if not (has $method (list "pick" "wsl")) -}}
{{-         $view = set $view $method (list) -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $names = $names | uniq | sortAlpha -}}

{{- /* Collect the items of the selected profiles (base is always selected).
  A pick profile contributes only its picked items; with no stored selection it contributes all of them.
  $pending: per pick profile, the items that were not offered at the last init. */ -}}
{{- $profiles := list -}}
{{- $wslDistro := "" -}}
{{- $pending := dict -}}
{{- range $name := $names -}}
{{-   if or (eq $name "base") (not $hasSelection) (has $name $selected) -}}
{{-     $profiles = append $profiles $name -}}
{{-     $picks := dig "picks" $name (list) $ -}}
{{-     $offered := dig "offered" $name (list) $ -}}
{{-     $notOffered := list -}}
{{-     range $source := $sources -}}
{{-       $definition := dig $name (dict) $source -}}
{{-       $isPick := dig "pick" false $definition -}}
{{-       range $method, $items := $definition -}}
{{-         if eq $method "wsl" -}}
{{-           $wslDistro = $items -}}
{{-         else if ne $method "pick" -}}
{{-           range $item := $items -}}
{{-             $label := splitList "/" $item | last -}}
{{-             if or (not $isPick) (not $hasSelection) (has $label $picks) -}}
{{-               $view = set $view $method (append (index $view $method) $item) -}}
{{-             end -}}
{{-             if and $isPick $hasOffered (not (has $label $offered)) -}}
{{-               $notOffered = append $notOffered $label -}}
{{-             end -}}
{{-           end -}}
{{-         end -}}
{{-       end -}}
{{-     end -}}
{{-     if $notOffered -}}
{{-       $pending = set $pending $name ($notOffered | uniq) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}

{{- /* tools: the label of every selected item (Scoop app without its bucket, module, dotnet tool, yazi plugin) */ -}}
{{- $tools := list -}}
{{- range $item := dig "scoop" (list) $view -}}
{{-   $tools = append $tools (splitList "/" $item | last) -}}
{{- end -}}
{{- range $method := list "modules" "dotnet_tools" "yazi_plugins" -}}
{{-   range $item := dig $method (list) $view -}}
{{-     $tools = append $tools $item -}}
{{-   end -}}
{{- end -}}

{{- /* Each item once, then the keys that are not item lists */ -}}
{{- range $method := keys $view -}}
{{-   $view = set $view $method (index $view $method | uniq) -}}
{{- end -}}
{{- $view = set $view "profiles" $profiles -}}
{{- $view = set $view "wsl" $wslDistro -}}
{{- /* The Windows WSL platform (admin step) is needed by a distro or by Rancher Desktop; the distro itself comes with sdk */ -}}
{{- $view = set $view "wsl_platform" (or (ne $wslDistro "") (has "rancher-desktop" $tools)) -}}
{{- $view = set $view "tools" ($tools | uniq) -}}
{{- $view = set $view "pending" $pending -}}
{{- $view | toJson -}}
