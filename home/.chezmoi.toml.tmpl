{{- $hook_extension := (eq .chezmoi.os "windows") | ternary  "ps1" "sh" -}}

{{- $email := promptString "email" }}
{{- $name := promptString "name" }}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}

[cd]
    command = "pwsh"

[diff]
    exclude = ["scripts"]

{{- if eq .chezmoi.os "windows" }}
[hooks.init.pre]
    script = ".chezmoihooks/install-pwsh.cmd"
{{ end -}}

[interpreters.ps1]
    command = "pwsh"
    args = ["-NoLogo", "-NoProfile"]