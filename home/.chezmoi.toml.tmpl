{{- $email := default (promptString "email") "john@doe.com" }}
{{- $name := default (promptString "name") "John Doe"  }}

progress = true

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}

[cd]
    command = "pwsh"

[diff]
    exclude = ["scripts"]
{{ if eq .chezmoi.os "windows" }}
[hooks.read-source-state.pre]
    command = {{ joinPath .chezmoi.sourceDir ".hooks/.install-pwsh.cmd" | quote }}
{{ end }}
[interpreters.ps1]
    command = "pwsh"
    args = ["-NoLogo", "-NoProfile"]