{{- $email := "vagrant@local" }}
{{- $name := "Vagrant User"  }}

{{- if not (env "VAGRANT") }}
    {{- $email := default (promptString "email") "john@doe.com" }}
    {{- $name := default (promptString "name") "John Doe"  }}
{{- end }}

progress = true
encryption = "age"

[age]
identity = "~/.config/chezmoi/key.txt"
recipient = "age1xvez3je4mhx7xswxu6gpalmrxq88uktcncthtqs8m7zcjgnjd4qsq05uw8"

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}

[cd]
    command = "pwsh"

[diff]
    exclude = ["scripts"]
    pager = "delta"

[interpreters.ps1]
    command = "pwsh"
    args = ["-NoLogo", "-NoProfile"]
