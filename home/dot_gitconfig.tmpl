# Identity and signing key come from encrypted data; CI skips that file and git skips a missing include
[include]
path = ~/.config/git/user.gitconfig

[gpg]
format = ssh
{{- if eq .chezmoi.os "windows" }}
[gpg "ssh"]
program = C:/Windows/System32/OpenSSH/ssh-keygen.exe
{{- end }}

[core]
pager = delta
{{- if eq .chezmoi.os "windows" }}
sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
{{- end }}

[color "status"]
changed = yellow
untracked = cyan

[alias]
st = status
commit-amend = commit --amend --no-edit

[rebase]
autosquash = true

[push]
default = matching
autoSetupRemote = true

[commit]
gpgsign = true

[tag]
gpgSign = true

[interactive]
diffFilter = delta --color-only

[merge]
tool = vscode

[mergetool "vscode"]
cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED
trustExitCode = false

[mergetool]
prompt = false

{{- if env "VAGRANT" }}{{/* Only for tests proposes */}}
[safe]
directory = %(prefix)///vboxsvr/Users_vagrant_.local_share_chezmoi/
{{ end -}}

[delta]
navigate = false
side-by-side = true
true-color = always

[diff "json"]
textconv = jq .
