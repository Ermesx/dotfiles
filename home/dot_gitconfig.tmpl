[user]
    name = {{ .name }}
    email = {{ .email }}
    signingkey = {{ join .chezmoi.sourceDir "dot_ssh/encrypted_id_ed25519.pub.age" | include | decrypt | trim }}
[gpg]
    format = ssh
{{- if eq .chezmoi.os "windows" }}
[gpg "ssh"]
    program = C:\\Windows\\System32\\OpenSSH\\ssh-keygen.exe
{{- end }}
[core]
    pager = delta
[color "status"]
    changed = yellow
    untracked = cyan
[alias]
    st = status
    commit-amend = commit --amend --no-edit
[rebase]
    autosquash = true
[push]
    default = matching
	autoSetupRemote = true
[commit]
    gpgsign = true
[tag]
    gpgSign = true
[interactive]
    diffFilter = delta --color-only
[merge]
    tool = vscode
[mergetool "vscode"]
    cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED
    trustExitCode = false
[mergetool]
    prompt = false
{{- if env "VAGRANT" -}}{{/* Only for tests proposes */}}
[safe]
    directory = %(prefix)///vboxsvr/Users_vagrant_.local_share_chezmoi/
{{ end -}}

[delta]
    navigate = false
    side-by-side = true
    true-color = always
