# Identity and signing key come from encrypted data; CI skips that file and git skips a missing include
[include]
path = ~/.config/git/user.gitconfig
{{- with dig "git" "work_email" "" . }}
# Work machine: the work email is the default, from the chezmoi config. Any github.com remote re-includes the
# personal identity; the blocks must stay after [user], a later email wins
[user]
email = {{ . }}
[includeIf "hasconfig:remote.*.url:https://github.com/**"]
path = ~/.config/git/user.gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
path = ~/.config/git/user.gitconfig
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/**"]
path = ~/.config/git/user.gitconfig
{{- end }}

[gpg]
format = ssh
{{- if eq .chezmoi.os "windows" }}
[gpg "ssh"]
program = C:/Windows/System32/OpenSSH/ssh-keygen.exe
{{- end }}

[core]
pager = delta
{{- if eq .chezmoi.os "windows" }}
sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
{{- end }}

[color "status"]
changed = yellow
untracked = cyan

[alias]
st = status
commit-amend = commit --amend --no-edit

[rebase]
autosquash = true

[push]
default = matching
autoSetupRemote = true

[commit]
gpgsign = true

[tag]
gpgSign = true

[interactive]
diffFilter = delta --color-only

[merge]
tool = vscode

[mergetool "vscode"]
cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED
trustExitCode = false

[mergetool]
prompt = false

{{- if env "VAGRANT" }}{{/* Only for tests proposes */}}
[safe]
directory = %(prefix)///vboxsvr/Users_vagrant_.local_share_chezmoi/
{{ end -}}

[delta]
navigate = false
side-by-side = true
true-color = always

[diff "json"]
textconv = jq .
