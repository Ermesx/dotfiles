# Pofiles hashes
{{- range (glob  (joinPath .chezmoi.sourceDir "dot_profile/*.ps1*")) }}
# {{ include . | sha256sum -}}
{{ end }}
{{- range (glob  (joinPath .chezmoi.sourceDir "dot_profile/tools/*")) }}
# {{ include . | sha256sum -}}
{{ end }}

# Import installed modules
{{- /* Only the modules of the selected profiles (the packages view), so e.g. DockerCompletion is not imported without containers */}}
{{- $v := includeTemplate "packages.tmpl" . | fromJson }}
{{- range $v.modules }}
Import-Module -Name {{ . | squote }}
{{- end }}

# Import Custom Modules
Import-Module -Name 'Write-Pretty' -Force

# Import all profile files
{{- $base := print .chezmoi.sourceDir "/dot_profile/" }}
{{- $target := print .chezmoi.config.destDir "/.profile/" }}
{{- range (glob  (joinPath .chezmoi.sourceDir "dot_profile/*.ps1*")) }}
. {{ replace $base $target . | replace ".tmpl" "" | squote -}}
{{ end }}

# Tool fragments of the selected tools
{{- /* Every fragment in dot_profile/tools (name as in the view's tools), alphabetical: a new tool needs no edit here.
  $last are loaded at the end in this order: both hook the prompt, and zoxide must be the last one */}}
{{- $last := list "starship" "zoxide" }}
{{- $fragments := list }}
{{- range (glob (joinPath .chezmoi.sourceDir "dot_profile/tools/*")) }}
{{-   $fragments = append $fragments (base . | replace ".tmpl" "" | replace ".ps1" "") }}
{{- end }}
{{- $order := list }}
{{- range $name := sortAlpha $fragments }}
{{-   if not (has $name $last) }}{{ $order = append $order $name }}{{ end }}
{{- end }}
{{- range $name := $last }}{{ $order = append $order $name }}{{ end }}
{{- range $name := $order }}
{{-   if has $name $v.tools }}
. {{ print $target "tools/" $name ".ps1" | squote }}
{{-   end }}
{{- end }}
