# Pofiles hashes
{{- range (glob  (joinPath .chezmoi.sourceDir "dot_profile/*.ps1*")) }}
# {{ include . | sha256sum -}}
{{ end }}

# Import installed modules
{{- /* Only the profiles that were installed: same rule as run_onchange_before_01-scoop (with CI=true, not
       ci.skip_scoop_profiles), so e.g. DockerCompletion is not imported where the containers profile was skipped */}}
{{- $skip := list }}
{{- if eq (env "CI") "true" }}{{ $skip = .ci.skip_scoop_profiles }}{{ end }}
{{- range $name, $profile := .packages.windows.profiles }}
{{-   if not (has $name $skip) }}
{{-     range (get $profile "modules" | default list) }}
Import-Module -Name {{ . | squote }}
{{-     end }}
{{-   end }}
{{- end }}

# Import Custom Modules
Import-Module -Name 'Write-Pretty' -Force

# Import all profile files
{{- $base := print .chezmoi.sourceDir "/dot_profile/" }}
{{- $target := print .chezmoi.config.destDir "/.profile/" }}
{{- range (glob  (joinPath .chezmoi.sourceDir "dot_profile/*.ps1*")) }}
. {{ replace $base $target . | replace ".tmpl" "" | squote -}}
{{ end }}
