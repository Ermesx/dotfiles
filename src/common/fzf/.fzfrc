--preview "bat --style=numbers,changes --color=always --line-range=:500 {}"
--bind "focus:transform-header:file --brief {}"
--color "fg:-1,fg+:#d0d0d0,bg:#282c34,bg+:#414752"
--color "hl:#5f87af,hl+:#5fd7ff,info:#b6af5b,marker:#87ff00"
--color "prompt:#d60000,spinner:#af5fff,pointer:#00ffff,header:#87afaf"
--color "border:#4a4a4a,preview-bg:#1a1a1a,label:#aeaeae,query:#d9d9d9"
--border "rounded"
--preview-window "border-rounded"
--prompt "> "
--marker "> "
--pointer "=>"
--separator "─"
--scrollbar "│"
--layout "reverse-list"
--info "right"
--ansi
